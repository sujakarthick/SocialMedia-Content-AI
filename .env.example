# ==============================================================================
# NammaContent AI - Environment Configuration Template
# Copy this file to .env.local for local development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth (https://supabase.com)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 2. AI Model Provider (Google Gemini API / OpenAI)
# ------------------------------------------------------------------------------
# Get your Gemini key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional fallback provider
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 3. Razorpay Subscription & Payments (https://razorpay.com)
# ------------------------------------------------------------------------------
# Test keys start with rzp_test_... ; Live keys start with rzp_live_...
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 4. App URL & Deployment
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
